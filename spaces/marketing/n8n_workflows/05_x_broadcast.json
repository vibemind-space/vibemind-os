  },
  "_meta": {
    "version": "2.0.0",
    "description": "x broadcast (Schicht 8.0). Receives the broadcast_approved bus event (payload: proposal_id, channel, body_text, subject, media_url, channel_params, bubble_id) — routing is channel-aware in the webhook bus (migration 038), so there is NO channel IF-filter here. verify_and_consume is the atomic exactly-once claim; a 409 (already consumed) exits via 'Respond skipped'.",
    "todo": "send-error branch (record_result with {error, status:'failed'}) not wired yet — a failed send surfaces as failed n8n execution.",
    "test_payload": {
      "proposal_id": "00000000-0000-0000-0000-000000000000",
      "channel": "x",
      "body_text": "Test broadcast body",
      "subject": null,
      "media_url": null,
      "channel_params": {},
      "bubble_id": "test-bubble"
    },
    "imports_required": {
      "credential_oauth": "X/Twitter OAuth2 — create in n8n UI, then replace REPLACE_ME_X_CREDENTIAL",
      "credential_header": "Marketing n8n API key"
    },
    "note": "body_text is hard-truncated to 280 chars — the Template-Skill should produce X-sized copy upstream."
  }
