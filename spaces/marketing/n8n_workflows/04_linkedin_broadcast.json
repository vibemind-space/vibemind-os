  "_meta": {
    "version": "2.1.0",
    "description": "linkedin broadcast (Schicht 8.0). Receives the broadcast_approved bus event (payload: proposal_id, channel, body_text, subject, media_url, channel_params, bubble_id) — routing is channel-aware in the webhook bus (migration 038), so there is NO channel IF-filter here. verify_and_consume is the atomic exactly-once claim; a 409 (already consumed) exits via 'Respond skipped'.",
    "todo": "send-error branch (record_result with {error, status:'failed'}) not wired yet — a failed send surfaces as failed n8n execution.",
    "test_payload": {
      "proposal_id": "00000000-0000-0000-0000-000000000000",
      "channel": "linkedin",
      "body_text": "Test broadcast body",
      "subject": null,
      "media_url": null,
      "channel_params": {},
      "bubble_id": "test-bubble"
    },
    "imports_required": {
      "credential_oauth": "LinkedIn Marketing (id=7dPKlFWvvBauW2Re) — OAuth flow via n8n UI",
      "credential_header": "Marketing n8n API key"
    },
    "linkedin_person": "The linkedIn node requires `person` (author member id). It is normally picked from a UI dropdown, which headless import cannot do. A 'LinkedIn: whoami' httpRequest node (same OAuth2 credential -> /v2/userinfo) supplies it at runtime via {{ $('LinkedIn: whoami').first().json.sub }}, so the workflow posts as whichever account the credential belongs to — no hardcoded id."
  }
