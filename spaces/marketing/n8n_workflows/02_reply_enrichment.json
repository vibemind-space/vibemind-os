    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_meta": {
    "version": "1.0.0",
    "description": "Marketing reply enrichment. Triggers on inbound_classified events where classification='reply'. Checks consent, fetches inbound, picks template, calls Rowboat for context, creates reply-proposal in draft status, posts Rowboat-result back as async callback. Curator sees proposal in Curator-Space and edits + requests approval.",
    "dsvgo_notes": [
      "Rowboat is local (container :3100) — no payload leaves the box.",
      "Consent check BEFORE building any draft (can_send=false → stop).",
      "Body preview limited to 500 bytes (full body stays in DB).",
      "Rowboat-context stored in proposals.rowboat_context, subject to 6.6 retention."
    ],
    "imports_required": {
      "credential_type": "Header Auth",
      "credential_name": "Marketing n8n API key"
    },
    "subscription_setup": "POST /api/webhook_subscriptions {api_key:..., name:'n8n-reply-enrichment', url:'http://host.docker.internal:5678/webhook/marketing-reply-enrichment', events:['inbound_classified'], secret:'<32+ chars>'}"
  }
}
