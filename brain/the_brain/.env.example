# ============================================================================
# Tahlamus Brain System - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys

# REQUIRED: LLM API Keys (at least one required for brain features)
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# REQUIRED: Memory System API Key
# Get your key from: https://supermemory.ai/
SUPERMEMORY_API_KEY=sk-your-key-here

# OPTIONAL: Direct Provider Keys (if not using OpenRouter)
# Only needed if you want to use specific providers directly
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OPTIONAL: Configuration Settings
DEV_MODE=true
LOG_LEVEL=INFO

# OPTIONAL: Cognitive Loop (unified brain cycle)
# Set to true to activate the inner cognitive loop instead of sequential pipeline
ENABLE_COGNITIVE_LOOP=true

# ============================================================================
# Setup Instructions:
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your API keys
# 3. Never commit .env to git (it's in .gitignore)
#
# See SYSTEM_STARTUP_GUIDE.md for detailed setup instructions
# ============================================================================
