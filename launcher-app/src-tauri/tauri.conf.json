{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeMind Launcher",
  "version": "0.1.0",
  "identifier": "com.vibemind.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "VibeMind",
        "width": 480,
        "height": 620,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
