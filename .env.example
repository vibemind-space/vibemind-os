# ============================================================================
# VibeMind-OS — Environment Configuration
# ============================================================================
# Copy to .env and fill in your API keys.
# Each service reads from this file or its own .env.

# ── LLM Provider Keys (at least one required) ──────────────────────────────
# OpenRouter (recommended — access to all models via one key)
# Get your key: https://openrouter.ai/
OPENROUTER_API_KEY=

# Groq (free tier, fast inference — great for testing)
# Get your key: https://console.groq.com/
GROQ_API_KEY=

# Anthropic (direct — for Claude models)
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# ── Service Ports ───────────────────────────────────────────────────────────
BRAIN_PORT=5000
OPENFANG_PORT=50051
BRIDGE_PORT=5100

# ── Brain (Tahlamus) ───────────────────────────────────────────────────────
# Memory system (optional — enables long-term memory)
SUPERMEMORY_API_KEY=
DEV_MODE=true
LOG_LEVEL=INFO

# ── OpenFang ────────────────────────────────────────────────────────────────
# Default model for all agents (override per-agent in agent.toml)
# Options: anthropic, groq, openrouter, openai, ollama
OPENFANG_DEFAULT_PROVIDER=groq
OPENFANG_DEFAULT_MODEL=llama-3.3-70b-versatile

# Claude Code CLI (optional — enables claude-code provider)
# Requires: npm install -g @anthropic-ai/claude-code && claude auth
# On Windows: add npm global bin to System PATH, not just Git Bash

# ── Bridge ──────────────────────────────────────────────────────────────────
BRAIN_URL=http://localhost:5000
OPENFANG_URL=http://localhost:50051

# ── Telegram (optional — for OpenFang chat) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
